#!/usr/bin/env bash
#
# Pre-push checks for this repository.
#
# Tracked rather than written into .git/hooks, and wired with core.hooksPath, so
# it survives a clone, shows up in review, and changes by the same process as
# the code it guards. Enable it with:
#
#     git config core.hooksPath .githooks
#
# Whatever else this repository should check before a push — its own tests, its
# own linters — belongs here too, and is its own question.

set -uo pipefail

failed=0

printf 'pre-push checks\n'

# The rules ratchet over Alfons and every consumer checked out on this machine
# (AL-024); the script itself skips a repository that is not there. Fails open
# on a missing bun: a missing tool is not evidence about the push being made,
# and a hook that refuses on its own machinery teaches --no-verify.
printf '  %-24s' 'rules ratchet'
if command -v bun >/dev/null 2>&1; then
    baseline="$(git rev-parse --show-toplevel)/rules-baseline.json"
    before="$(git hash-object "$baseline")"
    if ratchet_output="$(cd "$(git rev-parse --show-toplevel)" && bun run rules:ratchet 2>&1)"; then
        printf 'passed\n'
    else
        printf 'failed\n%s\n' "$ratchet_output"
        failed=1
    fi
    if [ "$(git hash-object "$baseline")" != "$before" ]; then
        printf '  %-24s%s\n' '' 'counts fell: commit rules-baseline.json to keep them'
    fi
else
    printf 'skipped (bun not found)\n'
fi

if [ "$failed" -ne 0 ]; then
    printf '\npush refused. Fix the above, or use --no-verify if you mean it.\n'
    exit 1
fi

printf '\nall checks passed\n'
exit 0
