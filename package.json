{
	"name": "@alfons/design",
	"version": "0.1.0",
	"type": "module",
	"private": false,
	"description": "Alfons design library — tokens, atoms and the design system agents build against",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./public": "./src/tokens/public.css",
		"./admin": "./src/tokens/admin.css",
		"./base": "./src/tokens/base.css",
		"./form-states": "./src/tokens/form-states.css"
	},
	"scripts": {
		"manifest": "bun run scripts/generate-manifest.ts",
		"manifest:check": "bun run scripts/generate-manifest.ts --check",
		"lifecycle:sync": "bun run scripts/sync-lifecycle-entities.ts",
		"mcp": "bun run src/mcp/server.ts",
		"mcp:smoke": "bun run scripts/mcp-smoke.ts",
		"build": "bun run manifest && bun run build:lib",
		"build:lib": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"shots": "node scripts/screenshot-stories.mjs"
	},
	"dependencies": {
		"@fontsource-variable/azeret-mono": "^5.2.11",
		"@fontsource/ibm-plex-serif": "^5.0.0",
		"@fontsource/rock-salt": "^5.0.0",
		"@internationalized/date": "^3.8.0",
		"gsap": "^3.14.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2",
		"d3": ">=7",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"d3": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte-vite": "^10.3.5",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tweakpane/core": "^2.0.5",
		"@types/node": "^26.0.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"playwright": "^1.62.1",
		"postcss": "^8.5.25",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.3.5",
		"svelte": "^5.55.3",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tweakpane": "^4.0.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.8",
		"zod": "^4.4.3"
	}
}
